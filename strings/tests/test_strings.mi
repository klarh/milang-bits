s = import "../strings.mi"

check_s label got expected world =
  msg = if (got == expected) ("PASS: " + label) ("FAIL: " + label)
  world.io.println msg

check_i label got expected world =
  msg = if (got == expected) ("PASS: " + label) ("FAIL: " + label)
  world.io.println msg

main world =
  check_s "repeat 3" (s.str_repeat "ab" 3) "ababab" world
  check_s "repeat 0" (s.str_repeat "x" 0) "" world
  check_s "pad_left" (s.pad_left "42" 5 "0") "00042" world
  check_s "pad_right" (s.pad_right "hi" 5 ".") "hi..." world
  check_s "center" (s.center "x" 5 "-") "--x--" world
  check_s "pad no-op" (s.pad_left "hello" 3 "0") "hello" world
  check_i "count 2" (s.count "abcabc" "abc") 2 world
  check_i "count 0" (s.count "hello" "xyz") 0 world
  check_i "is_empty true" (s.is_empty "") 1 world
  check_i "is_empty false" (s.is_empty "a") 0 world
  check_i "is_blank true" (s.is_blank "  \t ") 1 world
  check_i "is_blank false" (s.is_blank " a ") 0 world
  check_i "is_digit y" (s.is_digit "5") 1 world
  check_i "is_digit n" (s.is_digit "a") 0 world
  check_i "is_upper y" (s.is_upper "Z") 1 world
  check_i "is_lower y" (s.is_lower "z") 1 world
  check_i "is_alpha y" (s.is_alpha "A") 1 world
  check_i "is_alnum y" (s.is_alnum "3") 1 world
  check_i "is_space y" (s.is_space " ") 1 world
  check_i "all_digits y" (s.all_digits "12345") 1 world
  check_i "all_digits n" (s.all_digits "123a5") 0 world
  check_i "all_alpha y" (s.all_alpha "abcXYZ") 1 world
  check_s "chars" (toString (s.chars "abc")) (toString ["a", "b", "c"]) world
  check_s "reverse" (s.str_reverse "hello") "olleh" world
  check_s "take" (s.str_take 3 "hello") "hel" world
  check_s "drop" (s.str_drop 3 "hello") "lo" world
  check_s "capitalize" (s.capitalize "hello world") "Hello world" world
  check_s "title_case" (s.title_case "hello cruel world") "Hello Cruel World" world
  check_s "snake_to_camel" (s.snake_to_camel "my_var_name") "myVarName" world
  check_s "camel_to_snake" (s.camel_to_snake "myVarName") "my_var_name" world
  0
