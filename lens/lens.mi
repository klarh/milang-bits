-- lens: functional optics for nested record access and update
--
-- Provides composable getters and setters for working with
-- deeply nested records without manual getField/setField chains.

-- A lens is a record {get, set} where:
--   get : record -> value
--   set : record -> value -> record

-- Unwrap a Maybe value with a default
unwrap maybe dflt = maybe ->
  Just x = x
  Nothing = dflt

-- Create a lens for a field name
-- Uses getField (returns Maybe) and unwraps with default 0
field_get name r = unwrap (getField r name 0) 0
field name = {get = field_get name; set = (\r v -> setField r name v)}

-- Create a lens with a custom default for missing fields
field_default name dflt = {get = (\r -> unwrap (getField r name 0) dflt); \
  set = (\r v -> setField r name v)}

-- Compose two lenses: outer.inner
-- compose (field "a") (field "b") accesses r.a.b
compose outer inner = \
  {get = (\r -> inner.get (outer.get r)); \
   set = (\r v -> outer.set r (inner.set (outer.get r) v))}

-- View through a lens
view lens r = lens.get r

-- Set through a lens
set lens r v = lens.set r v

-- Modify through a lens (apply function to focused value)
over lens f r = lens.set r (f (lens.get r))

-- Identity lens (returns the whole record)
id_lens = {get = (\r -> r); set = (\r v -> v)}

-- Constant lens (always returns a fixed value, set is no-op)
constant v = {get = (\r -> v); set = (\r x -> r)}

-- Pair of lenses: view both at once (returns [a, b])
pair l1 l2 = {get = (\r -> [l1.get r, l2.get r]); \
  set = (\r v -> r)}

-- Lens that maps a function over the viewed value (read-only transform)
mapped f lens = {get = (\r -> f (lens.get r)); set = lens.set}

-- Lens for first element of a list
first_get xs = fold (\acc x -> if (acc == -99999) (x) (acc)) (-99999) (take 1 xs)
first_lens = {get = first_get; set = (\xs v -> push [v] (drop 1 xs))}

-- Lens for last element of a list
last_get xs = fold (\acc x -> x) 0 xs
last_lens = {get = last_get; set = (\xs v -> xs)}

-- Path lens: access nested fields via list of names
-- path_lens ["a", "b", "c"] accesses r.a.b.c
path_step acc name = compose acc (field name)
path_lens names = fold path_step id_lens names

-- Conditional set: only set if predicate on new value is true
set_if lens pred r v = if (pred v) (set lens r v) (r)
