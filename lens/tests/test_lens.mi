-- Test lens library
l = import "../lens.mi"

check :~ [console]
check label got expected world = \
  if (toString got == toString expected) \
    (world.io.println ("PASS: " + label)) \
    (world.io.println ("FAIL: " + label + "\n  got:      " + toString got + "\n  expected: " + toString expected))

-- Test data
person = {name = "Alice"; age = 30; address = {city = "NYC"; zip = "10001"}}

main world =
  -- field lens
  name_lens = l.field "name"
  age_lens = l.field "age"
  check "view name" (l.view name_lens person) "Alice" world
  check "view age" (l.view age_lens person) 30 world

  -- set through lens
  p2 = l.set name_lens person "Bob"
  check "set name" (l.view name_lens p2) "Bob" world
  check "set preserves age" (l.view age_lens p2) 30 world

  -- over (modify)
  p3 = l.over age_lens (\x -> x + 1) person
  check "over age +1" (l.view age_lens p3) 31 world

  -- compose lenses for nested access
  city_lens = l.compose (l.field "address") (l.field "city")
  check "compose view" (l.view city_lens person) "NYC" world

  -- set through composed lens
  p4 = l.set city_lens person "LA"
  check "compose set" (l.view city_lens p4) "LA" world
  check "compose preserves name" (l.view name_lens p4) "Alice" world

  -- over through composed lens
  zip_lens = l.compose (l.field "address") (l.field "zip")
  p5 = l.over zip_lens (\z -> z + "-5678") person
  check "compose over" (l.view zip_lens p5) "10001-5678" world

  -- identity lens
  check "id view" (l.view l.id_lens 42) 42 world

  -- constant lens
  c = l.constant "hello"
  check "constant view" (l.view c person) "hello" world
  check "constant set noop" (toString (l.set c person "x")) (toString person) world

  -- with_default
  dl = l.field_default "missing" 99
  check "field_default missing" (l.view dl person) 99 world
  dl2 = l.field_default "name" "nobody"
  check "field_default present" (l.view dl2 person) "Alice" world

  -- mapped lens (read-only transform)
  upper_name = l.mapped toUpper name_lens
  check "mapped view" (l.view upper_name person) "ALICE" world

  -- pair of lenses
  p_lens = l.pair name_lens age_lens
  check "pair view" (l.view p_lens person) ["Alice", 30] world

  -- path_lens for deep access
  deep = l.path_lens ["address", "city"]
  check "path_lens view" (l.view deep person) "NYC" world
  p6 = l.set deep person "SF"
  check "path_lens set" (l.view deep p6) "SF" world

  -- first_lens
  xs = [10, 20, 30]
  check "first view" (l.view l.first_lens xs) 10 world
  xs2 = l.set l.first_lens xs 99
  check "first set" (l.view l.first_lens xs2) 99 world

  -- last_lens
  check "last view" (l.view l.last_lens xs) 30 world

  -- set_if
  p7 = l.set_if age_lens (\v -> v > 0) person 25
  check "set_if true" (l.view age_lens p7) 25 world
  p8 = l.set_if age_lens (\v -> v > 100) person 25
  check "set_if false" (l.view age_lens p8) 30 world

  -- chained operations
  p9 = l.set city_lens (l.over age_lens (\a -> a * 2) person) "Boston"
  check "chained age" (l.view age_lens p9) 60 world
  check "chained city" (l.view city_lens p9) "Boston" world

  0
