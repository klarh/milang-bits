-- Test graph library
gr = import "../graph.mi"

check_i label got expected world =
  msg = if (got == expected) ("PASS: " + label) ("FAIL: " + label + " got=" + toString got + " exp=" + toString expected)
  world.io.println msg

check_s label got expected world =
  msg = if (got == expected) ("PASS: " + label) ("FAIL: " + label + " got=" + got + " exp=" + expected)
  world.io.println msg

-- Build test graph: a -> b, a -> c, b -> d (sequential bindings to avoid PE blowup)
g0 = gr.add_node (gr.add_node (gr.add_node (gr.add_node gr.empty "a") "b") "c") "d"
g1 = gr.add_edge g0 "a" "b"
g2 = gr.add_edge g1 "a" "c"
g = gr.add_edge g2 "b" "d"

main world =
  -- Construction
  check_i "node_count" (gr.node_count g) 4 world
  check_i "edge_count" (gr.edge_count g) 3 world
  -- has_edge
  check_i "has_edge yes" (gr.has_edge g "a" "b") 1 world
  check_i "has_edge no" (gr.has_edge g "b" "a") 0 world
  check_i "has_edge yes2" (gr.has_edge g "b" "d") 1 world
  -- has_node
  check_i "has_node yes" (gr.has_node g "a") 1 world
  check_i "has_node no" (gr.has_node g "z") 0 world
  -- neighbors
  check_s "neighbors a" (toString (gr.neighbors g "a")) (toString ["b", "c"]) world
  check_s "neighbors b" (toString (gr.neighbors g "b")) (toString ["d"]) world
  check_s "neighbors d" (toString (gr.neighbors g "d")) (toString []) world
  -- in_neighbors
  check_s "in_neighbors b" (toString (gr.in_neighbors g "b")) (toString ["a"]) world
  check_s "in_neighbors d" (toString (gr.in_neighbors g "d")) (toString ["b"]) world
  check_s "in_neighbors a" (toString (gr.in_neighbors g "a")) (toString []) world
  -- degrees
  check_i "out_degree a" (gr.out_degree g "a") 2 world
  check_i "in_degree d" (gr.in_degree g "d") 1 world
  check_i "degree b" (gr.degree g "b") 2 world
  -- sources and sinks
  check_s "sources" (toString (gr.sources g)) (toString ["a"]) world
  check_s "sinks" (toString (gr.sinks g)) (toString ["c", "d"]) world
  -- is_empty
  check_i "is_empty no" (gr.is_empty g) 0 world
  check_i "is_empty yes" (gr.is_empty gr.empty) 1 world
  -- edges_from
  check_i "edges_from a count" (len (gr.edges_from g "a")) 2 world
  check_i "edges_to d count" (len (gr.edges_to g "d")) 1 world
  -- undirected
  gu0 = gr.add_node (gr.add_node gr.empty "x") "y"
  gu = gr.add_edge_u gu0 "x" "y"
  check_i "undirected xy" (gr.has_edge gu "x" "y") 1 world
  check_i "undirected yx" (gr.has_edge gu "y" "x") 1 world
  check_i "undirected degree" (gr.degree gu "x") 2 world
  -- from_edges
  g2 = gr.from_edges ["p", "q", "r"] [["p", "q"], ["q", "r"]]
  check_i "from_edges nodes" (gr.node_count g2) 3 world
  check_i "from_edges edges" (gr.edge_count g2) 2 world
  check_i "from_edges has" (gr.has_edge g2 "p" "q") 1 world
  -- remove_edges_from
  g3 = gr.remove_edges_from g "a"
  check_i "remove_from count" (gr.edge_count g3) 1 world
  check_i "remove_from check" (gr.has_edge g3 "a" "b") 0 world
  check_i "remove_from kept" (gr.has_edge g3 "b" "d") 1 world
  0
