-- Benchmark: count primes up to 100,000 (trial division)
is_prime n = if (n < 2) 0 (check n 2)

check n d = if (d * d > n) 1 (if (n % d == 0) 0 (check n (d + 1)))

count_primes n = fold (\acc i -> acc + is_prime i) 0 (range 2 (n + 1))

main world = world.io.println (toString (count_primes 100000))
