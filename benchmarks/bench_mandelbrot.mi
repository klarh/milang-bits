-- Benchmark: Mandelbrot set — 200x200 grid, max 100 iterations
-- x in [-2, 1), y in [-1.5, 1.5), dx=dy=0.015

go zr zi i maxi cx cy = if (i >= maxi) maxi (if (zr * zr + zi * zi > 4.0) i (go (zr * zr - zi * zi + cx) (2.0 * zr * zi + cy) (i + 1) maxi cx cy))

scan cx cy total px py rows cols maxi dx dy = if (py >= rows) total (if (px >= cols) (scan (0.0 - 2.0) (cy + dy) total 0 (py + 1) rows cols maxi dx dy) (scan (cx + dx) cy (total + go 0.0 0.0 0 maxi cx cy) (px + 1) py rows cols maxi dx dy))

main world = world.io.println (toString (scan (0.0 - 2.0) (0.0 - 1.5) 0 0 0 200 200 100 0.015 0.015))
