-- Benchmark: Functional quicksort on 5000 pseudo-random integers
-- Tests: list manipulation, higher-order functions (filter), recursion

sort_rng s = (s * 1103515245 + 12345) % 2147483648

gen_data n s acc = if (n <= 0) acc \
  (gen_data (n - 1) (sort_rng s) (push acc (s % 10000)))

-- Sentinel -1 detects empty lists (data is in [0,9999])
qsort xs = if (default (0 - 1) (head xs) < 0) xs \
  (qsort_go (default 0 (head xs)) (default [] (tail xs)))

qsort_go p rest = if (default (0 - 1) (head rest) < 0) (push [] p) \
  (concat \
    (push (qsort (filter (\x -> x < p) rest)) p) \
    (qsort (filter (\x -> x >= p) rest)))

main world = world.io.println (toString \
  (fold (\a x -> a + x) 0 (qsort (gen_data 5000 42 []))))
