q = import "../query.mi"

check :~ [console]
check label got expected world = \
  if (got == expected) \
    (world.io.println ("PASS: " + label)) \
    (world.io.println ("FAIL: " + label + " got=" + got + " exp=" + expected))

main world =
  xs = [3, 1, 4, 1, 5, 9, 2, 6, 5, 3]

  check "where_" (toString (q.where_ (\x -> x > 4) xs)) "[5, 9, 6, 5]" world
  check "select" (toString (q.select (\x -> x * 2) [1, 2, 3])) "[2, 4, 6]" world
  check "order_by" (toString (q.order_by (\x -> x) [3, 1, 2])) "[1, 2, 3]" world
  check "order_by desc" (toString (q.order_by_desc (\x -> x) [3, 1, 2])) "[3, 2, 1]" world
  check "limit" (toString (q.limit 3 xs)) "[3, 1, 4]" world
  check "offset" (toString (q.offset 7 xs)) "[6, 5, 3]" world
  check "distinct" (toString (q.distinct [1, 2, 1, 3, 2])) "[1, 2, 3]" world
  check "count" (toString (q.count xs)) "10" world
  check "sum_of" (toString (q.sum_of [1, 2, 3, 4])) "10" world
  check "min_of" (toString (q.min_of xs)) "1" world
  check "max_of" (toString (q.max_of xs)) "9" world
  0
