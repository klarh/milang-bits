-- array: contiguous growable arrays backed by C malloc/realloc
--
-- Provides O(1) index, amortised O(1) push, O(n) insert/remove.
-- Uses milang's C FFI for the backing store; wraps raw operations
-- with a milang-friendly API.
--
-- Note: Arrays store integer values. For general-purpose use with
-- milang values (strings, records), use Lists.

ffi = import' "array_ffi.h" ({src = "array_ffi.c"})

-- Create a new empty array with initial capacity
new cap = gc_manage (ffi.mi_array_new cap) ffi.mi_array_free

-- Create an array from a list of integers
from_list xs = gc_manage result ffi.mi_array_free
  result = ffi.mi_array_new (len xs)
  dummy = fold (\_ x -> ffi.mi_array_push result x) 0 xs

-- Array length
length a = ffi.mi_array_len a

-- Get element at index (returns 0 for out-of-bounds)
get a idx = ffi.mi_array_get a idx

-- Set element at index (mutates in place)
set a idx val = ffi.mi_array_set a idx val

-- Push element to end (mutates in place)
push_back a val = ffi.mi_array_push a val

-- Pop element from end (mutates, returns removed value)
pop_back a = ffi.mi_array_pop a

-- Swap two elements by index
swap a i j = ffi.mi_array_swap a i j

-- Reverse array in place
reverse_mut a = ffi.mi_array_reverse a

-- Clear all elements
clear a = ffi.mi_array_clear a

-- Slice: new array from start (inclusive) to end (exclusive)
arr_slice a start end = gc_manage (ffi.mi_array_slice a start end) ffi.mi_array_free

-- Copy: new array with same contents
copy a = gc_manage (ffi.mi_array_copy a) ffi.mi_array_free

-- Concat: new array with elements of a followed by b
arr_concat x y = gc_manage (ffi.mi_array_concat x y) ffi.mi_array_free

-- Sort array in place (ascending integer order)
sort_mut a = ffi.mi_array_sort a

-- Find index of value (-1 if not found)
index_of a val = ffi.mi_array_index_of a val

-- Check if array contains value
arr_contains a val = ffi.mi_array_contains a val

-- Convert array to list
to_list a = fold (\acc i -> push acc (ffi.mi_array_get a i)) [] (range 0 (ffi.mi_array_len a))

-- Free array memory (call when done)

-- Map: apply function to each element, return new array
arr_map f a = gc_manage result ffi.mi_array_free
  result = ffi.mi_array_new (ffi.mi_array_len a)
  dummy = fold (\acc i -> ffi.mi_array_push result (f (ffi.mi_array_get a i))) 0 (range 0 (ffi.mi_array_len a))

-- Filter: return new array with elements where predicate is true
arr_filter f a = gc_manage result ffi.mi_array_free
  result = ffi.mi_array_new (ffi.mi_array_len a)
  dummy = fold (\acc i -> if (f (ffi.mi_array_get a i)) (ffi.mi_array_push result (ffi.mi_array_get a i)) (0)) 0 (range 0 (ffi.mi_array_len a))

-- Fold over array elements
arr_fold f acc a = fold (\ac i -> f ac (ffi.mi_array_get a i)) acc (range 0 (ffi.mi_array_len a))

-- Sum all elements
arr_sum a = arr_fold (\acc x -> acc + x) 0 a

-- Array to string for display
arr_to_string a = "[" + join ", " (map toString (to_list a)) + "]"

-- Create array from integer range [start, end)
from_range start end = gc_manage result ffi.mi_array_free
  result = ffi.mi_array_new (end - start)
  dummy = fold (\_ i -> ffi.mi_array_push result i) 0 (range start end)

-- List of {idx; val} records for each element
arr_enumerate a = map (\i -> {idx = i; val = ffi.mi_array_get a i}) (range 0 (ffi.mi_array_len a))

-- Pair elements from two arrays as list of {fst; snd} records
arr_zip a b = map (\i -> {fst = ffi.mi_array_get a i; snd = ffi.mi_array_get b i}) (range 0 n)
  n = if (ffi.mi_array_len a < ffi.mi_array_len b) (ffi.mi_array_len a) (ffi.mi_array_len b)

-- Combine two arrays element-wise with function f
arr_zip_with f a b = map (\i -> f (ffi.mi_array_get a i) (ffi.mi_array_get b i)) (range 0 n)
  n = if (ffi.mi_array_len a < ffi.mi_array_len b) (ffi.mi_array_len a) (ffi.mi_array_len b)

-- First n elements (new array)
arr_take a n = gc_manage (ffi.mi_array_slice a 0 n) ffi.mi_array_free

-- Skip first n elements (new array)
arr_drop a n = gc_manage (ffi.mi_array_slice a n (ffi.mi_array_len a)) ffi.mi_array_free

-- Does any element satisfy predicate? (returns 1 or 0)
arr_any pred a = arr_fold (\acc x -> if (acc == 1) 1 (pred x)) 0 a

-- Do all elements satisfy predicate? (returns 1 or 0)
arr_all pred a = arr_fold (\acc x -> if (acc == 0) 0 (pred x)) 1 a

-- Count elements matching predicate
arr_count pred a = arr_fold (\acc x -> if (pred x) (acc + 1) acc) 0 a

-- Minimum element (0 for empty array)
arr_min a = arr_fold (\acc x -> if (x < acc) x acc) (ffi.mi_array_get a 0) a

-- Maximum element (0 for empty array)
arr_max a = arr_fold (\acc x -> if (x > acc) x acc) (ffi.mi_array_get a 0) a

-- First index where predicate holds (-1 if none)
arr_find_index pred a = fold (\acc i -> if (acc == neg1) (if (pred (ffi.mi_array_get a i)) i acc) acc) neg1 (range 0 (ffi.mi_array_len a))
  neg1 = 0 - 1

-- Element-wise equality check (returns 1 or 0)
arr_equals a b = if (ffi.mi_array_len a == ffi.mi_array_len b) \
  (fold (\acc i -> if (acc == 0) 0 (if (ffi.mi_array_get a i == ffi.mi_array_get b i) 1 0)) 1 (range 0 (ffi.mi_array_len a))) \
  0
