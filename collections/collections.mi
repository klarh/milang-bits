-- collections: Maps, Sets, Deques, Priority Queues
--
-- C-backed data structures for milang.
-- HashMap: string-keyed int-valued hash map
-- Deque: double-ended queue (ring buffer)
-- MinHeap: min-priority queue
-- IntSet: integer set

ffi = import' "collections_ffi.h" ({src = "collections_ffi.c"})

-- HashMap (string -> int)
hm_new cap = gc_manage (ffi.mi_hm_new cap) ffi.mi_hm_free
hm_size m = ffi.mi_hm_size m
hm_put m key val = ffi.mi_hm_put m key val
hm_get m key = if (ffi.mi_hm_has m key) (Just (ffi.mi_hm_get m key)) Nothing
hm_get_or m key default = if (ffi.mi_hm_has m key) (ffi.mi_hm_get m key) default
hm_has m key = ffi.mi_hm_has m key
hm_remove m key = ffi.mi_hm_remove m key
hm_clear m = ffi.mi_hm_clear m

-- Deque (double-ended queue of ints)
deque_new cap = gc_manage (ffi.mi_deque_new cap) ffi.mi_deque_free
deque_size d = ffi.mi_deque_size d
deque_push_back d val = ffi.mi_deque_push_back d val
deque_push_front d val = ffi.mi_deque_push_front d val
deque_pop_back d = ffi.mi_deque_pop_back d
deque_pop_front d = ffi.mi_deque_pop_front d
deque_peek_front d = ffi.mi_deque_peek_front d
deque_peek_back d = ffi.mi_deque_peek_back d
deque_get d idx = ffi.mi_deque_get d idx
deque_clear d = ffi.mi_deque_clear d

-- MinHeap (priority queue, smallest first)
heap_new cap = gc_manage (ffi.mi_heap_new cap) ffi.mi_heap_free
heap_size h = ffi.mi_heap_size h
heap_push h val = ffi.mi_heap_push h val
heap_pop h = ffi.mi_heap_pop h
heap_peek h = ffi.mi_heap_peek h

-- IntSet (set of integers, 0 cannot be stored)
iset_new cap = gc_manage (ffi.mi_iset_new cap) ffi.mi_iset_free
iset_size s = ffi.mi_iset_size s
iset_add s val = ffi.mi_iset_add s val
iset_has s val = ffi.mi_iset_has s val
iset_remove s val = ffi.mi_iset_remove s val
iset_clear s = ffi.mi_iset_clear s

-- HashMap convenience
hm_from_list pairs = gc_manage m ffi.mi_hm_free
  m = ffi.mi_hm_new (len pairs)
  dummy = fold (\_ p -> ffi.mi_hm_put m p.key p.val) 0 pairs

hm_keys m = map (\i -> ffi.mi_hm_key_at m i) (range 0 (ffi.mi_hm_size m))

hm_values m = map (\i -> ffi.mi_hm_val_at m i) (range 0 (ffi.mi_hm_size m))

hm_to_list m = map (\i -> {key = ffi.mi_hm_key_at m i; val = ffi.mi_hm_val_at m i}) (range 0 (ffi.mi_hm_size m))

hm_put_all m entries = fold (\_ p -> ffi.mi_hm_put m p.key p.val) 0 entries

hm_update m key f = if (ffi.mi_hm_has m key) (ffi.mi_hm_put m key (f (ffi.mi_hm_get m key))) 0

hm_merge m1 m2 = fold (\_ i -> ffi.mi_hm_put m1 (ffi.mi_hm_key_at m2 i) (ffi.mi_hm_val_at m2 i)) 0 (range 0 (ffi.mi_hm_size m2))

-- Deque convenience
deque_from_list xs = gc_manage d ffi.mi_deque_free
  d = ffi.mi_deque_new (len xs)
  dummy = fold (\_ x -> ffi.mi_deque_push_back d x) 0 xs

deque_to_list d = map (\i -> ffi.mi_deque_get d i) (range 0 (ffi.mi_deque_size d))

deque_contains d val = ffi.mi_deque_contains d val

deque_reverse d = ffi.mi_deque_reverse d

-- MinHeap convenience
heap_from_list xs = gc_manage h ffi.mi_heap_free
  h = ffi.mi_heap_new (len xs)
  dummy = fold (\_ x -> ffi.mi_heap_push h x) 0 xs

heap_push_all h xs = fold (\_ x -> ffi.mi_heap_push h x) 0 xs

heap_to_sorted_list h = fold (\acc _ -> push acc (ffi.mi_heap_pop h)) [] (range 0 (ffi.mi_heap_size h))

-- IntSet convenience
iset_from_list xs = gc_manage s ffi.mi_iset_free
  s = ffi.mi_iset_new (len xs)
  dummy = fold (\_ x -> ffi.mi_iset_add s x) 0 xs

iset_to_list s = map (\i -> ffi.mi_iset_elem_at s i) (range 0 (ffi.mi_iset_size s))

iset_add_all s xs = fold (\_ x -> ffi.mi_iset_add s x) 0 xs

iset_union a b = gc_manage result ffi.mi_iset_free
  result = ffi.mi_iset_new (ffi.mi_iset_size a + ffi.mi_iset_size b)
  d1 = fold (\_ i -> ffi.mi_iset_add result (ffi.mi_iset_elem_at a i)) 0 (range 0 (ffi.mi_iset_size a))
  d2 = fold (\_ i -> ffi.mi_iset_add result (ffi.mi_iset_elem_at b i)) 0 (range 0 (ffi.mi_iset_size b))

iset_intersection a b = gc_manage result ffi.mi_iset_free
  result = ffi.mi_iset_new (ffi.mi_iset_size a)
  dummy = fold (\_ i -> if (ffi.mi_iset_has b (ffi.mi_iset_elem_at a i)) (ffi.mi_iset_add result (ffi.mi_iset_elem_at a i)) 0) 0 (range 0 (ffi.mi_iset_size a))

iset_difference a b = gc_manage result ffi.mi_iset_free
  result = ffi.mi_iset_new (ffi.mi_iset_size a)
  dummy = fold (\_ i -> if (ffi.mi_iset_has b (ffi.mi_iset_elem_at a i)) 0 (ffi.mi_iset_add result (ffi.mi_iset_elem_at a i))) 0 (range 0 (ffi.mi_iset_size a))

iset_is_subset a b = fold (\acc i -> if (acc == 0) 0 (ffi.mi_iset_has b (ffi.mi_iset_elem_at a i))) 1 (range 0 (ffi.mi_iset_size a))

iset_equals a b = if (ffi.mi_iset_size a == ffi.mi_iset_size b) (iset_is_subset a b) 0
