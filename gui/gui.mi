ann ffi ns = values =>
  ffi.struct "SDL_Rect" |> ffi.field "x" "int32" |> ffi.field "y" "int32" |> ffi.field "w" "int32" |> ffi.field "h" "int32"
  ffi.struct "SDL_Color" |> ffi.field "r" "uint8" |> ffi.field "g" "uint8" |> ffi.field "b" "uint8" |> ffi.field "a" "uint8"
  ffi.opaque "SDL_Event" |> ffi.include "<SDL2/SDL_events.h>" |> ffi.accessor "type" "uint32" |> ffi.accessor "key.keysym.sym" "int32" |> ffi.accessor "motion.x" "int32" |> ffi.accessor "motion.y" "int32" |> ffi.accessor "button.x" "int32" |> ffi.accessor "button.y" "int32"
  ffi.opaque "SDL_Surface" |> ffi.include "<SDL2/SDL_surface.h>" |> ffi.accessor "w" "int32" |> ffi.accessor "h" "int32"

sdl = import' "/usr/include/SDL2/SDL_ttf.h" ({
  filter = ["SDL_Init", "SDL_Quit", "SDL_CreateWindow", "SDL_DestroyWindow",
            "SDL_CreateRenderer", "SDL_DestroyRenderer",
            "SDL_SetRenderDrawColor", "SDL_RenderClear", "SDL_RenderPresent",
            "SDL_RenderDrawRect", "SDL_RenderFillRect",
            "SDL_RenderDrawLine", "SDL_RenderDrawPoint",
            "SDL_SetRenderTarget", "SDL_RenderCopy",
            "SDL_CreateTexture", "SDL_CreateTextureFromSurface",
            "SDL_DestroyTexture", "SDL_FreeSurface",
            "SDL_PollEvent", "SDL_Delay", "SDL_GetTicks",
            "SDL_SetWindowTitle",
            "TTF_Init", "TTF_Quit", "TTF_OpenFont", "TTF_CloseFont",
            "TTF_RenderText_Blended",
            "calloc", "free",
            "SDL_INIT_VIDEO",
            "SDL_RENDERER_ACCELERATED", "SDL_RENDERER_PRESENTVSYNC",
            "SDL_WINDOW_SHOWN",
            "SDL_TEXTUREACCESS_TARGET",
            "SDL_WINDOWPOS_CENTERED", "SDL_PIXELFORMAT_RGBA8888",
            "SDL_QUIT", "SDL_KEYDOWN", "SDL_KEYUP",
            "SDL_MOUSEMOTION", "SDL_MOUSEBUTTONDOWN", "SDL_MOUSEBUTTONUP",
            "SDLK_ESCAPE", "SDLK_SPACE", "SDLK_RETURN",
            "SDLK_UP", "SDLK_DOWN", "SDLK_LEFT", "SDLK_RIGHT",
            "SDLK_a", "SDLK_d", "SDLK_s", "SDLK_w"];
  flags = "-lSDL2 -lSDL2_ttf";
  annotate = ann
})

-- Event types (auto-extracted from SDL2 enums)
evt_quit = sdl.SDL_QUIT
evt_keydown = sdl.SDL_KEYDOWN
evt_keyup = sdl.SDL_KEYUP
evt_mousemotion = sdl.SDL_MOUSEMOTION
evt_mousedown = sdl.SDL_MOUSEBUTTONDOWN
evt_mouseup = sdl.SDL_MOUSEBUTTONUP

-- Key constants (all auto-extracted from SDL2 headers)
key_escape = sdl.SDLK_ESCAPE
key_space = sdl.SDLK_SPACE
key_return = sdl.SDLK_RETURN
key_up = sdl.SDLK_UP
key_down = sdl.SDLK_DOWN
key_left = sdl.SDLK_LEFT
key_right = sdl.SDLK_RIGHT
key_a = sdl.SDLK_a
key_d = sdl.SDLK_d
key_s = sdl.SDLK_s
key_w = sdl.SDLK_w

-- Color constructors
color r g b a = {r = r; g = g; b = b; a = a}
rgb r g b = {r = r; g = g; b = b; a = 255}
black = rgb 0 0 0
white = rgb 255 255 255
red = rgb 255 0 0
green = rgb 0 255 0
blue = rgb 0 0 255
yellow = rgb 255 255 0
cyan = rgb 0 255 255
magenta = rgb 255 0 255
gray = rgb 128 128 128

-- Rect constructor
rect x y w h = {x = x; y = y; w = w; h = h}

-- Window lifecycle
init w h title = {window = win; renderer = ren; event = ev}
  d1 = sdl.SDL_Init sdl.SDL_INIT_VIDEO
  d2 = sdl.TTF_Init 0
  win = sdl.SDL_CreateWindow title sdl.SDL_WINDOWPOS_CENTERED sdl.SDL_WINDOWPOS_CENTERED w h sdl.SDL_WINDOW_SHOWN
  ren = sdl.SDL_CreateRenderer win (0 - 1) (sdl.SDL_RENDERER_ACCELERATED + sdl.SDL_RENDERER_PRESENTVSYNC)
  ev = gc_manage (sdl.calloc 1 56).val sdl.free

quit ctx = r
  r1 = sdl.SDL_DestroyRenderer ctx.renderer
  r2 = sdl.SDL_DestroyWindow ctx.window
  r3 = sdl.TTF_Quit 0
  r = sdl.SDL_Quit 0

-- Drawing
clear ctx c = r
  r1 = sdl.SDL_SetRenderDrawColor ctx.renderer c.r c.g c.b c.a
  r = sdl.SDL_RenderClear ctx.renderer

present ctx = sdl.SDL_RenderPresent ctx.renderer

draw_rect ctx r c = result
  d1 = sdl.SDL_SetRenderDrawColor ctx.renderer c.r c.g c.b c.a
  result = sdl.SDL_RenderDrawRect ctx.renderer r

fill_rect ctx r c = result
  d1 = sdl.SDL_SetRenderDrawColor ctx.renderer c.r c.g c.b c.a
  result = sdl.SDL_RenderFillRect ctx.renderer r

draw_line ctx x1 y1 x2 y2 c = result
  d1 = sdl.SDL_SetRenderDrawColor ctx.renderer c.r c.g c.b c.a
  result = sdl.SDL_RenderDrawLine ctx.renderer x1 y1 x2 y2

draw_point ctx x y c = result
  d1 = sdl.SDL_SetRenderDrawColor ctx.renderer c.r c.g c.b c.a
  result = sdl.SDL_RenderDrawPoint ctx.renderer x y

-- Events
next_event ctx = ev
  has = sdl.SDL_PollEvent ctx.event
  etype = if (has == 0) 0 (sdl.SDL_Event_type ctx.event)
  ekey = if (etype == sdl.SDL_KEYDOWN) (sdl.SDL_Event_key_keysym_sym ctx.event) (if (etype == sdl.SDL_KEYUP) (sdl.SDL_Event_key_keysym_sym ctx.event) 0)
  emx = if (etype == sdl.SDL_MOUSEMOTION) (sdl.SDL_Event_motion_x ctx.event) (if (etype == sdl.SDL_MOUSEBUTTONDOWN) (sdl.SDL_Event_button_x ctx.event) (if (etype == sdl.SDL_MOUSEBUTTONUP) (sdl.SDL_Event_button_x ctx.event) 0))
  emy = if (etype == sdl.SDL_MOUSEMOTION) (sdl.SDL_Event_motion_y ctx.event) (if (etype == sdl.SDL_MOUSEBUTTONDOWN) (sdl.SDL_Event_button_y ctx.event) (if (etype == sdl.SDL_MOUSEBUTTONUP) (sdl.SDL_Event_button_y ctx.event) 0))
  ev = {type = etype; key = ekey; mx = emx; my = emy}

poll_event ctx = sdl.SDL_PollEvent ctx.event
event_type ctx = sdl.SDL_Event_type ctx.event
event_key ctx = sdl.SDL_Event_key_keysym_sym ctx.event
mouse_x ctx = sdl.SDL_Event_motion_x ctx.event
mouse_y ctx = sdl.SDL_Event_motion_y ctx.event

-- Text rendering
font_paths = ["/usr/share/fonts/TTF/DejaVuSans.ttf", "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf", "/usr/share/fonts/dejavu-sans-fonts/DejaVuSans.ttf", "/usr/share/fonts/truetype/liberation/LiberationSans-Regular.ttf", "/usr/share/fonts/liberation-sans/LiberationSans-Regular.ttf", "/usr/share/fonts/liberation/LiberationSans-Regular.ttf", "/usr/share/fonts/noto/NotoSans-Regular.ttf", "/usr/share/fonts/truetype/noto/NotoSans-Regular.ttf", "/usr/share/fonts/google-noto/NotoSans-Regular.ttf"]

load_font size = find_font font_paths size

find_font paths size = paths ->
  Nil = 0
  Cons path rest = try_font path rest size

-- Pointer null check (FFI pointers are now Maybe: Nothing=null, Just=valid)
ptr_is_null p = p == Nothing

try_font path rest size = result
  f = sdl.TTF_OpenFont path size
  result = if (ptr_is_null f) (find_font rest size) f.val

-- Workaround: inline records containing function params to avoid compiler bug
-- where where-clause bindings with records referencing function params become unbound
draw_text ctx text x y size c = r
  font = load_font size
  surf = (sdl.TTF_RenderText_Blended font text ({r = c.r; g = c.g; b = c.b; a = c.a})).val
  tex = sdl.SDL_CreateTextureFromSurface ctx.renderer surf
  sw = sdl.SDL_Surface_w surf
  sh = sdl.SDL_Surface_h surf
  d1 = sdl.SDL_RenderCopy ctx.renderer tex Nothing (rect x y sw sh)
  d2 = sdl.SDL_DestroyTexture tex
  d3 = sdl.SDL_FreeSurface surf
  r = sdl.TTF_CloseFont font

-- Timing
delay ms = sdl.SDL_Delay ms
ticks = sdl.SDL_GetTicks 0

-- Window control
set_title ctx title = sdl.SDL_SetWindowTitle ctx.window title

-- Canvas (render-to-texture for persistent drawing)
create_canvas ctx w h = gc_manage (sdl.SDL_CreateTexture ctx.renderer sdl.SDL_PIXELFORMAT_RGBA8888 sdl.SDL_TEXTUREACCESS_TARGET w h).val sdl.SDL_DestroyTexture
canvas_target ctx canvas = sdl.SDL_SetRenderTarget ctx.renderer canvas
screen_target ctx = sdl.SDL_SetRenderTarget ctx.renderer 0
draw_canvas ctx canvas = sdl.SDL_RenderCopy ctx.renderer canvas Nothing Nothing
