gui = import "../gui.mi"

main world = r1
  win = gui.init 640 480 "milang Drawing Canvas"
  canvas = gui.create_canvas win 640 480
  d1 = gui.canvas_target win canvas
  d2 = gui.clear win gui.white
  d3 = gui.draw_text win "Click to draw, Space=clear, ESC=quit" 10 10 16 gui.gray
  d4 = gui.screen_target win
  dummy = draw_loop win canvas 0
  dummy2 = gui.quit win
  r1 = world.io.println "Canvas closed"

draw_loop win canvas drawing = idle_or_handle win canvas drawing (gui.poll_event win)

idle_or_handle win canvas drawing ev = if (ev < 1) (idle win canvas drawing) (handle_event win canvas drawing)

idle win canvas drawing = draw_loop win canvas drawing
  d1 = gui.clear win gui.black
  d2 = gui.draw_canvas win canvas
  d3 = gui.present win
  d4 = gui.delay 16

handle_event win canvas drawing = dispatch win canvas drawing (gui.event_type win)

dispatch win canvas drawing t = if (t == gui.evt_quit) 0 (if (t == gui.evt_keydown) (handle_key win canvas drawing) (if (t == gui.evt_mousedown) (draw_loop win canvas 1) (if (t == gui.evt_mouseup) (draw_loop win canvas 0) (if (t == gui.evt_mousemotion) (handle_motion win canvas drawing) (draw_loop win canvas drawing)))))

handle_key win canvas drawing = dispatch_key win canvas drawing (gui.event_key win)

dispatch_key win canvas drawing k = if (k == gui.key_escape) 0 (if (k == gui.key_space) (do_clear win canvas drawing) (draw_loop win canvas drawing))

do_clear win canvas drawing = draw_loop win canvas drawing
  d1 = gui.canvas_target win canvas
  d2 = gui.clear win gui.white
  d3 = gui.screen_target win

handle_motion win canvas drawing = if (drawing > 0) (do_paint win canvas) (draw_loop win canvas drawing)

do_paint win canvas = draw_loop win canvas 1
  mx = gui.mouse_x win
  my = gui.mouse_y win
  d1 = gui.canvas_target win canvas
  d2 = gui.fill_rect win (gui.rect (mx - 3) (my - 3) 6 6) gui.black
  d3 = gui.screen_target win
