gui = import "../gui.mi"

main world = r1
  win = gui.init 640 480 "milang GUI - Bouncing Ball"
  dummy = loop win 320 240 3 2 0
  dummy2 = gui.quit win
  r1 = world.io.println "Demo finished"

loop win x y dx dy ci = if (drain_quit win > 0) 0 (render win x y dx dy ci)

render win x y dx dy ci = loop win nx ny ndx ndy nci
  d1 = gui.clear win gui.black
  d2 = gui.fill_rect win (gui.rect (x - 10) (y - 10) 20 20) gui.red
  d3 = gui.draw_rect win (gui.rect 0 0 640 480) gui.white
  d4 = gui.draw_text win "Press ESC to quit" 10 10 16 gui.white
  d5 = gui.present win
  d6 = gui.delay 16
  hx = if (x + dx < 10) 1 (if (x + dx > 630) 1 0)
  hy = if (y + dy < 10) 1 (if (y + dy > 470) 1 0)
  ndx = if (hx > 0) (0 - dx) dx
  ndy = if (hy > 0) (0 - dy) dy
  nx = x + ndx
  ny = y + ndy
  nci = ci + hx + hy

drain_quit win = drain_check win 0

drain_check win found = if (gui.poll_event win < 1) found (drain_check win (if (found > 0) 1 (is_quit win)))

is_quit win = if (gui.event_type win == gui.evt_quit) 1 (if (gui.event_type win == gui.evt_keydown) (if (gui.event_key win == gui.key_escape) 1 0) 0)
