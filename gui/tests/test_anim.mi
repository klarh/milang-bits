gui = import "../gui.mi"

main world = r1
  win = gui.init 400 300 "Animation"
  dummy = anim win 0
  dummy2 = gui.quit win
  r1 = world.io.println "done"

anim win frame = if (frame > 200) 0 (draw_frame win frame)

draw_frame win frame = anim win (frame + 1)
  x = frame * 2
  d1 = gui.clear win gui.black
  d2 = gui.fill_rect win (gui.rect x 100 30 30) gui.red
  d3 = gui.present win
  d4 = gui.delay 16
